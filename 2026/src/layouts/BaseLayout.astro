---
import "../styles/global.css";
import "../styles/motion.css";

interface Props {
  title?: string;
  description?: string;
  /** 構造化データ（schema.org の JSON-LD）。検索結果の表示に使われる */
  jsonLd?: Record<string, unknown>;
}

const {
  title = "TechRAMEN 2026 Conference",
  description = "2026年11月20日(pre)・21日(main)、北海道・富良野のコンシェルジュ フラノで開催するTechRAMEN Conference。手作りで、あたたかく。",
  jsonLd,
} = Astro.props;

// ページごとの正規 URL（以前は全ページがトップを指していて、観光ページ・会場マップが検索に載らなかった）
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = "https://techramenconf.net/2026/og-image.png";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- favicon（2025から流用） -->
    <link rel="icon" href={`${base}favicon.svg`} sizes="any" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="TechRAMEN 2026 Conference — 2026.11.20–21 富良野" />
    <meta property="og:site_name" content="TechRAMEN 2026 Conference" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <meta name="theme-color" content="#f3e8d8" />

    <!-- JS有効を即マーク（スクロール演出はJS有効時のみ・内容は隠さない） -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Yomogi&family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <!-- 手描き風の歪み用SVGフィルタ（枠線・アイコンの輪郭をラフにする） -->
    <svg
      width="0"
      height="0"
      aria-hidden="true"
      focusable="false"
      style="position:absolute;width:0;height:0;overflow:hidden"
    >
      <defs>
        <filter id="rough">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.012"
            numOctaves="2"
            seed="7"
            result="noise"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="6"></feDisplacementMap>
        </filter>
        <filter id="rough-ink">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.035"
            numOctaves="2"
            seed="4"
            result="noise"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.8"></feDisplacementMap>
        </filter>
        <!-- ボタン・札など小さい紙片用のちぎれ（2 種類を交互に使い、同じ破れ方が並ばないようにする） -->
        <filter id="torn-sm" x="-5%" y="-10%" width="110%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="3" seed="11" result="noise"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5"></feDisplacementMap>
        </filter>
        <filter id="torn-sm2" x="-5%" y="-10%" width="110%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.055" numOctaves="3" seed="23" result="noise"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5"></feDisplacementMap>
        </filter>
        <filter id="torn">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.016"
            numOctaves="3"
            seed="4"
            result="noise"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="13"></feDisplacementMap>
        </filter>
      </defs>
    </svg>
    <slot />
    <script>
      import "../scripts/paperDom";
      import "../scripts/interactions";
    </script>
  </body>
</html>
