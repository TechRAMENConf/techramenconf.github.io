---
// スポンサー（企業＝ラーメン法人応援団、個人＝ラーメン応援団）。
// 欄の中の空に、紙の切り絵の気球として流す。企業は 1 口につき気球 1 機。
// 気球を押すと「つかまえる」小さなゲーム（気球あつめ）。つかまえた記録はその端末にだけ残す。
// 気球の下に一覧も置く（読み上げ・動きを減らす設定・全員を一度に見る用）。
//
// - 企業: data/corporate_sponsors.json（当面は手で書く。口数ぶん同じ社を並べる＝2025 と同じ形）
// - 個人: 2025 と同じくビルド時に GAS から取得。取れないときは保存分 data/personal_sponsors.json
// どちらも 0 件なら欄ごと出さない。
//
// ロゴ・アバターは fortee の画像。WebGL には使えない（CORS が無い）ので、気球は DOM＋SVG で作る。
import { PERSONAL_SPONSORS } from "../data/personalSponsors";
import savedPersonal from "../data/personal_sponsors.json";
import corporateRaw from "../data/corporate_sponsors.json";

interface Personal {
  userName: string;
  avatarUrl?: string;
  twitterUrl?: string;
}
interface CorporateRow {
  userName: string;
  avatarUrl?: string;
  url?: string;
}

const validPersonal = (list: unknown): Personal[] =>
  Array.isArray(list)
    ? (list as Personal[]).filter((s) => typeof s?.userName === "string" && s.userName.trim() !== "")
    : [];

let personal: Personal[] = [];
if (PERSONAL_SPONSORS.gasUrl) {
  try {
    const res = await fetch(PERSONAL_SPONSORS.gasUrl, { signal: AbortSignal.timeout(10000) });
    if (res.ok) personal = validPersonal(await res.json());
  } catch (err) {
    console.warn("[Sponsors] GAS から応援団を取得できませんでした。保存分を使います", err);
  }
}
if (personal.length === 0) personal = validPersonal(savedPersonal);

// 企業: 同じ社の行数＝口数
const corporate = Object.values(
  (corporateRaw as CorporateRow[])
    .filter((c) => c?.userName?.trim())
    .reduce<Record<string, CorporateRow & { kuchi: number }>>((acc, c) => {
      acc[c.userName] ??= { ...c, kuchi: 0 };
      acc[c.userName].kuchi++;
      return acc;
    }, {}),
).sort((a, b) => b.kuchi - a.kuchi);

// fortee の画像 URL（個人は相対パス、企業は絶対 URL）。未設定は null
const img = (u?: string) =>
  !u || u.includes("avatar-blank") ? null : /^https?:/.test(u) ? u : new URL(u.replace(/^\//, ""), "https://fortee.jp/").href;

// 画像が無いときの 1 文字。匿名の応援団は「？」、会社は「株式会社」などを除いた頭文字
const initial = (name: string) =>
  name.includes("匿名") ? "？" : name.replace(/株式会社|合同会社|有限会社|一般社団法人/g, "").trim().slice(0, 1);

// 名前から決まる疑似乱数（ビルドのたびに色・順番が変わらないように）
const hash = (s: string) => {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
  return (h >>> 0) / 4294967295;
};

// ゲームの記録用 ID: 名前＋同名の通し番号（匿名の応援団は同じ名前で何人もいる）
const seen = new Map<string, number>();
const idOf = (kind: string, name: string) => {
  const k = `${kind}:${name}`;
  const nth = seen.get(k) ?? 0;
  seen.set(k, nth + 1);
  return nth ? `${k}#${nth}` : k;
};

// サイトの色（ロゴと同じ）。2 色で気球の縦じまにする
const PALETTE = ["#a8364a", "#8a74c0", "#d4a046", "#c07a3e", "#7a9a44"];
const LIGHT = ["#e8b7bf", "#cfc3e6", "#f1dca8", "#e9c39d", "#cbdba9"];

// 応援団: 1 行＝1 口（法人と同じく、まとめずに口数ぶん並べる・飛ばす）。
// 口数は同じ名前の行数（「匿名」は別々の人なので 1 口ずつ）。気球の柄と速さに使う
const kuchiOf = new Map<string, number>();
for (const p of personal) kuchiOf.set(p.userName, (kuchiOf.get(p.userName) ?? 0) + 1);
const personList = personal.map((p) => ({
  ...p,
  id: idOf("p", p.userName),
  src: img(p.avatarUrl),
  kuchi: p.userName.includes("匿名") ? 1 : kuchiOf.get(p.userName)!,
  // 「隠し味（匿名応援団）」のような名前は、かっこの前で改行して、かっこ内を小さく
  main: p.userName.split("（")[0],
  sub: p.userName.includes("（") ? p.userName.slice(p.userName.indexOf("（")) : "",
}));
// 企業は 1 口ごとに ID を持つ（気球 1 機・一覧のシール 1 枚に対応）
const corpList = corporate.map((c) => ({
  ...c,
  ids: Array.from({ length: c.kuchi }, () => idOf("c", c.userName)),
  src: img(c.avatarUrl),
}));

// 気球の幅（px）
const W = 52;
// 口数が多いほど速く飛ぶ（つかまえにくい＝ゲームとして手ごわい。一覧は下にあるので見せる時間より遊びを優先）
// 空を横切る時間の倍率。応援団: 1 口 / 2 / 3 / 4 口以上
const SPEED = [1, 0.8, 0.65, 0.5];
// 法人: 1 口 / 2-3 / 4-9 / 10 口以上
const corpPace = (kuchi: number) => (kuchi >= 10 ? 0.55 : kuchi >= 4 ? 0.7 : kuchi >= 2 ? 0.85 : 1);

interface Member {
  id: string;
  name: string;
  href?: string;
  src: string | null;
  corp: boolean;
  kuchi: number;
  deco: number; // 柄の豪華さ 1..4（応援団の口数）
  style: string;
}
interface Unit {
  members: Member[];
  style: string;
  order: number;
}

const colors = (seed: string) => {
  const c = Math.floor(hash(seed) * PALETTE.length);
  return `--c1:${PALETTE[c]};--c2:${LIGHT[(c + 2) % LIGHT.length]}`;
};

// 1 機ぶんの「隊」（空を流れる外枠＋気球）を作る
const unitOf = (m: Omit<Member, "style">, tone: string, pace = 1): Unit => ({
  order: hash(m.id + "#"),
  style: `--uw:${W}px;--uh:${Math.round(W * 1.9)}px;--dur:${Math.round((34 + hash(m.id) * 14) * pace)}s`,
  members: [{ ...m, style: `--w:${W}px;--mx:0px;--my:0px;--bob:${(4 + hash(m.id + "b") * 3).toFixed(1)}s;${tone}` }],
});

const units: Unit[] = [
  ...personList.map((p) =>
    unitOf(
      { id: p.id, name: p.userName, href: p.twitterUrl, src: p.src, corp: false, kuchi: p.kuchi, deco: Math.min(p.kuchi, 4) },
      colors(p.id),
      SPEED[Math.min(p.kuchi, 4) - 1],
    ),
  ),
  // 法人は 1 口 1 機。同じ社は同じ色
  ...corpList.flatMap((c) =>
    c.ids.map((id) =>
      unitOf(
        { id, name: c.userName, href: c.url, src: c.src, corp: true, kuchi: c.kuchi, deco: 1 },
        colors(c.userName),
        corpPace(c.kuchi),
      ),
    ),
  ),
  // 出てくる順（企業も個人も混ぜる）
].sort((a, b) => a.order - b.order);

// 帯のジグザグ（柄 2 以上）
const ZIG = (() => {
  const top = Array.from({ length: 11 }, (_, k) => `${k * 10},${k % 2 ? 46 : 50}`);
  const bottom = Array.from({ length: 11 }, (_, k) => `${100 - k * 10},${k % 2 ? 64 : 60}`);
  return [...top, ...bottom].join(" ");
})();

const total = units.reduce((s, u) => s + u.members.length, 0);
const hasAny = total > 0;
// 画像が読めないとき（リンク切れなど）は、隣の 1 文字に切り替える
const FALLBACK = "this.hidden=true;this.nextElementSibling.hidden=false";
---

{
  hasAny && (
    <section id="sponsors" class="section">
      <div class="wrap sheet reveal">
        <p class="eyebrow">応援してくれる人たち</p>
        <h2 class="section-title">応援団</h2>

        <div class="game" data-game data-total={total}>
          <p class="game__hud">
            <span class="game__lead hand">気球をつかまえて、応援団を集めよう</span>
            <span class="game__count">
              つかまえた <b data-count>0</b> / {total}
            </span>
            <button type="button" class="game__reset" data-reset hidden>
              もう一度
            </button>
          </p>

          {/* 空（装飾＋ゲーム）。一覧は下にあるので、読み上げ・キーボード操作からは外す */}
          <div class="sky" aria-hidden="true" data-sky>
            <span class="sky__cloud sky__cloud--a" />
            <span class="sky__cloud sky__cloud--b" />
            {units.map((u, ui) => (
              <span class="unit" style={u.style}>
                {u.members.map((b, mi) => {
                  const k = `${ui}-${mi}`;
                  return (
                    <span
                      class:list={["bln", b.corp && "bln--corp", `bln--d${b.deco}`]}
                      style={b.style}
                      data-id={b.id}
                      data-name={b.name}
                      data-href={b.href || undefined}
                      data-corp={b.corp ? "" : undefined}
                      data-kuchi={b.corp ? undefined : b.kuchi}
                    >
                      <span class="bln__bob">
                        <svg class="bln__env" viewBox="0 0 100 124">
                          <defs>
                            <clipPath id={`bc-${k}`}>
                              <path d="M50 3C80 3 97 26 94 54C91 79 67 94 59 104H41C33 94 9 79 6 54C3 26 20 3 50 3Z" />
                            </clipPath>
                          </defs>
                          {/* 白い台紙（少し大きく、手で切った縁）。4 口以上は金の縁 */}
                          <path
                            class="bln__backing"
                            d="M50 0C83 0 100 25 97 55C94 81 69 97 61 107H39C31 97 6 81 3 55C0 25 17 0 50 0Z"
                          />
                          {b.deco >= 4 && <path class="bln__flag" d="M50 2V-14M50 -14L66 -9L50 -4" />}
                          <g clip-path={`url(#bc-${k})`}>
                            <rect x="0" y="0" width="100" height="110" fill="var(--c1)" />
                            <ellipse cx="50" cy="52" rx="30" ry="62" fill="var(--c2)" />
                            <ellipse cx="50" cy="52" rx="13" ry="62" fill="var(--c1)" />
                            {/* 2 口: 紙のジグザグの帯 */}
                            {b.deco >= 2 && <polygon class="bln__band" points={ZIG} />}
                            {/* 3 口: 帯に金の菱形、てっぺんに金の飾り */}
                            {b.deco >= 3 && (
                              <>
                                <ellipse class="bln__gold" cx="50" cy="4" rx="22" ry="9" />
                                {[14, 32, 50, 68, 86].map((x) => (
                                  <path class="bln__gold" d={`M${x} 49L${x + 5} 55L${x} 61L${x - 5} 55Z`} />
                                ))}
                              </>
                            )}
                          </g>
                          {/* 吊り紐。4 口以上は金の吹き流しも */}
                          <path class="bln__rope" d="M42 104L45 122M58 104L55 122" />
                          {b.deco >= 4 && <path class="bln__streamer" d="M22 84q-6 10 0 20t0 20M78 84q6 10 0 20t0 20" />}
                        </svg>
                        {/* かご＝アバター／ロゴの丸シール */}
                        <span class:list={["bln__card", b.corp && "bln__card--logo"]}>
                          {b.src && <img src={b.src} alt="" loading="lazy" decoding="async" onerror={FALLBACK} />}
                          <span class="bln__initial" hidden={!!b.src}>
                            {initial(b.name)}
                          </span>
                        </span>
                      </span>
                    </span>
                  );
                })}
              </span>
            ))}
          </div>

          {/* つかまえたときの名札 */}
          <p class="catch" data-catch hidden>
            <span class="catch__msg">
              <b data-catch-name /><span data-catch-verb> をつかまえた！</span>
            </span>
            <span class="catch__note" data-catch-note hidden />
            <a class="catch__link" data-catch-link target="_blank" rel="noopener" hidden />
          </p>
          <p class="done hand" data-done hidden>
            全員つかまえた！ 応援ありがとうございます
          </p>
        </div>

        {
          corpList.length > 0 && (
            <div class="sp-group">
              <h3 class="sp-group__h hand">
                ラーメン法人応援団<small>{corpList.length} 社</small>
              </h3>
              <ul class="corp">
                {corpList.map((c) => {
                  const Tag = c.url ? "a" : "div";
                  return (
                    <li class="corp__row">
                      <Tag
                        class="corp__link"
                        {...(c.url ? { href: c.url, target: "_blank", rel: "noopener" } : {})}
                      >
                        <span class="corp__head">
                          <span class="corp__name">{c.userName}</span>
                          <span class="corp__kuchi">{c.kuchi} 口</span>
                        </span>
                        {/* 1 口＝ロゴのシール 1 枚 */}
                        <span class="corp__seals" aria-hidden="true">
                          {c.ids.map((id) => (
                            <span class="corp__seal" data-catch-id={id}>
                              {c.src && <img src={c.src} alt="" loading="lazy" decoding="async" onerror={FALLBACK} />}
                              <span class="corp__initial" hidden={!!c.src}>
                                {initial(c.userName)}
                              </span>
                            </span>
                          ))}
                        </span>
                      </Tag>
                    </li>
                  );
                })}
              </ul>
            </div>
          )
        }

        {
          personList.length > 0 && (
            <div class="sp-group">
              <h3 class="sp-group__h hand">
                ラーメン応援団<small>{personList.length} 口</small>
              </h3>
              <ul class="seals">
                {personList.map((s) => {
                  const Tag = s.twitterUrl ? "a" : "span";
                  return (
                    <li data-catch-id={s.id}>
                      <Tag
                        class="seal"
                        {...(s.twitterUrl ? { href: s.twitterUrl, target: "_blank", rel: "noopener" } : {})}
                      >
                        {s.src && (
                          <img src={s.src} alt="" width="48" height="48" loading="lazy" decoding="async" onerror={FALLBACK} />
                        )}
                        <span class="seal__none" aria-hidden="true" hidden={!!s.src}>
                          {initial(s.userName)}
                        </span>
                        <span class="seal__name">
                          {s.main}
                          {s.sub && <span class="seal__sub">{s.sub}</span>}
                        </span>
                      </Tag>
                    </li>
                  );
                })}
              </ul>
            </div>
          )
        }

        {
          PERSONAL_SPONSORS.joinUrl && (
            <a class="btn sp-join" href={PERSONAL_SPONSORS.joinUrl} target="_blank" rel="noopener">
              応援団員になる
            </a>
          )
        }
      </div>
    </section>
  )
}

<script>
  // 気球あつめ。
  // 空には「席」の数だけ気球が出る。空を抜けるか、つかまえると席が空き、まだつかまえていない人から次が出る。
  // （全員つかまえるまで、つかまえ済みの気球は出てこない）
  // つかまえた記録は localStorage（その端末だけ。使えなくてもゲームは遊べる）。
  const KEY = "tr2026:sponsor-caught";
  const game = document.querySelector<HTMLElement>("[data-game]");
  const sky = game?.querySelector<HTMLElement>("[data-sky]");

  if (game && sky) {
    const units = [...sky.querySelectorAll<HTMLElement>(".unit")];
    const all = [...sky.querySelectorAll<HTMLElement>(".bln")];
    const members = (u: HTMLElement) => [...u.querySelectorAll<HTMLElement>(".bln")];
    const total = all.length;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const seats = Math.min(units.length, sky.clientWidth < 560 ? 7 : 14);

    // 記録: { ID: つかまえた回数 }
    const load = (): Map<string, number> => {
      try {
        const v = JSON.parse(localStorage.getItem(KEY) || "{}");
        // 以前の形式（ID の配列）は 1 回ずつとして読む
        return new Map(Array.isArray(v) ? v.map((id: string) => [id, 1]) : Object.entries(v));
      } catch {
        return new Map();
      }
    };
    const save = () => {
      try {
        localStorage.setItem(KEY, JSON.stringify(Object.fromEntries(caught)));
      } catch {
        /* 保存できなくても遊べる */
      }
    };
    const caught = load();
    const isCaught = (b: HTMLElement) => caught.has(b.dataset.id!);

    const countEl = game.querySelector<HTMLElement>("[data-count]")!;
    const resetEl = game.querySelector<HTMLButtonElement>("[data-reset]")!;
    const doneEl = game.querySelector<HTMLElement>("[data-done]")!;
    const catchEl = game.querySelector<HTMLElement>("[data-catch]")!;
    const catchName = game.querySelector<HTMLElement>("[data-catch-name]")!;
    const catchVerb = game.querySelector<HTMLElement>("[data-catch-verb]")!;
    const catchNote = game.querySelector<HTMLElement>("[data-catch-note]")!;
    const catchLink = game.querySelector<HTMLAnchorElement>("[data-catch-link]")!;

    // 一覧・空の縁の色とカウンター
    const render = () => {
      const n = all.filter(isCaught).length;
      countEl.textContent = String(n);
      resetEl.hidden = n === 0;
      doneEl.hidden = n < total;
      document.querySelectorAll<HTMLElement>("[data-catch-id]").forEach((el) => {
        el.classList.toggle("is-caught", caught.has(el.dataset.catchId!));
      });
      // 空を飛んでいる気球の縁も（リセットしたとき戻す）
      for (const b of all) b.classList.toggle("is-caught", isCaught(b));
    };

    // 席: 縦の位置（段）と、止まっているときの横の位置
    const seatOf = new Map<HTMLElement, number>();
    let cursor = 0;
    const next = (): HTMLElement | undefined => {
      // まだつかまえていない人のいる隊を優先。全員つかまえたら、どの隊も飛ぶ
      for (const wantNew of [true, false]) {
        for (let k = 0; k < units.length; k++) {
          const u = units[(cursor + k) % units.length];
          if (seatOf.has(u) || (wantNew && members(u).every(isCaught))) continue;
          cursor = (cursor + k + 1) % units.length;
          return u;
        }
      }
    };
    const launch = (seat: number, head: number) => {
      const u = next();
      if (!u) return;
      seatOf.set(u, seat);
      const lane = (seat * 0.618034) % 1;
      const y = 3 + lane * 60;
      u.style.setProperty("--y", `${y.toFixed(1)}%`);
      u.style.setProperty("--x", `${(((seat + 0.5) / seats) * 88).toFixed(1)}%`);
      u.style.setProperty("--delay", `${head}s`);
      for (const b of members(u)) {
        b.classList.remove("is-pop", "is-gone");
        b.classList.toggle("is-caught", isCaught(b));
      }
      u.classList.remove("is-up");
      void u.offsetWidth; // アニメーションを最初からやり直す
      u.classList.add("is-up");
    };
    const land = (u: HTMLElement) => {
      const seat = seatOf.get(u);
      if (seat === undefined) return;
      seatOf.delete(u);
      u.classList.remove("is-up");
      launch(seat, still ? 0 : Math.random() * 3);
    };
    // つかまえた気球が消えたあと、隊が空っぽなら席を空ける
    const gone = (b: HTMLElement) => {
      b.classList.add("is-gone");
      const u = b.closest<HTMLElement>(".unit")!;
      if (members(u).every((m) => m.classList.contains("is-gone"))) land(u);
    };

    // 最初は席ごとに、空のいろいろな位置から始める
    for (let s = 0; s < seats; s++) {
      launch(s, still ? 0 : -((s + Math.random() * 0.5) / seats) * 40);
    }

    sky.addEventListener("animationend", (e) => {
      const t = e.target as HTMLElement;
      if (e.animationName === "drift" && t.classList.contains("unit")) land(t);
      if (e.animationName === "pop") gone(t.closest<HTMLElement>(".bln")!);
    });

    // 動いている的なので、押した瞬間（pointerdown）で判定する。
    // click だと押してから離すまでに気球が動いてずれ、取りこぼすことがある
    sky.addEventListener("pointerdown", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>(".unit.is-up .bln:not(.is-pop, .is-gone)");
      if (!b) return;
      e.preventDefault();
      const times = (caught.get(b.dataset.id!) ?? 0) + 1;
      caught.set(b.dataset.id!, times);
      save();
      render();
      b.classList.add("is-pop");
      // 動きを減らす設定ではしぼむ動きが無いので、すぐ消す
      if (still) gone(b);

      catchName.textContent = b.dataset.name!;
      catchVerb.textContent = times > 1 ? ` をまたつかまえた！（${times} 回目）` : " をつかまえた！";
      const kuchi = Number(b.dataset.kuchi || 0);
      catchNote.hidden = kuchi < 2;
      catchNote.textContent = `${kuchi} 口で応援`;
      const href = b.dataset.href;
      catchLink.hidden = !href;
      if (href) {
        catchLink.href = href;
        catchLink.textContent = "corp" in b.dataset ? "サイトを見る" : "X を見る";
      }
      catchEl.hidden = false;
      catchEl.classList.remove("is-new");
      void catchEl.offsetWidth;
      catchEl.classList.add("is-new");
    });

    resetEl.addEventListener("click", () => {
      caught.clear();
      save();
      render();
      catchEl.hidden = true;
    });

    // 空が見えているあいだだけ気球を動かす
    new IntersectionObserver(([e]) => sky.classList.toggle("is-on", e.isIntersecting)).observe(sky);
    render();
  }
</script>

<style>
  /* ---------- ゲームの見出し ---------- */
  .game {
    margin-top: 1.6rem;
  }
  .game__hud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: 0 0 0.8rem;
  }
  .game__lead {
    font-size: 1.25rem;
