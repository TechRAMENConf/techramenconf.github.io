---
// しおりナビ: ページ内の主要セクションへ 1 タップで飛べる目次。
// - 広い画面（1280px 以上）: 右端に色紙のしおりが並ぶ
// - 1024〜1279px: しおりの頭（アイコン）だけ覗かせ、ホバー・フォーカス・現在地で引き出す
// - それ未満: 画面下の紙帯タブバー
import Icon from "./Icon.astro";

const items = [
  { id: "dates", label: "日程・会場", short: "日程", icon: "calendar" },
  { id: "cfp", label: "登壇募集", short: "登壇", icon: "mic" },
  { id: "access", label: "会場・アクセス", short: "会場", icon: "train" },
  { id: "travel", label: "観光", short: "観光", icon: "map" },
  { id: "news", label: "おしらせ", short: "おしらせ", icon: "note" },
] as const;
---

<nav class="shiori torn" aria-label="ページ内の目次">
  <ul class="shiori__list">
    {
      items.map((it) => (
        <li>
          <a class="shiori__tab torn" href={`#${it.id}`} data-shiori={it.id}>
            <Icon name={it.icon} size="1.3em" />
            <span class="shiori__label">{it.label}</span>
            <span class="shiori__short">{it.short}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .shiori {
    position: fixed;
    z-index: 20;
  }
  .shiori__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .shiori__tab {
    color: var(--ink);
    text-decoration: none;
  }
  .shiori__tab:focus-visible {
    outline: 3px solid var(--grape);
    outline-offset: 2px;
  }

  /* ---- モバイル〜タブレット: 画面下の紙帯 ---- */
  @media (max-width: 1023px) {
    .shiori {
      inset: auto 0 0 0;
      padding-bottom: env(safe-area-inset-bottom);
      --torn-bg: var(--paper-card);
      --torn-shadow: drop-shadow(0 -3px 5px rgba(46, 40, 38, 0.25));
    }
    /* 上辺だけ破れて見えるよう、左右と下は画面外へ逃がす */
    .shiori::after {
      inset: 0 -8px -8px;
    }
    .shiori__tab::after {
      display: none;
    }
    .shiori__list {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
    }
    .shiori__tab {
      display: grid;
      justify-items: center;
      gap: 0.1rem;
      padding: 0.45rem 0.2rem 0.4rem;
      font-size: 0.7rem;
      font-weight: 700;
      line-height: 1.2;
      color: var(--ink-soft);
      border-top: 4px solid transparent;
    }
    .shiori__label {
      display: none;
    }
    .shiori__tab[aria-current="location"] {
      color: var(--wine);
      border-top-color: var(--gold);
    }
    /* 本文の最後がタブバーに隠れないように */
    :global(body) {
      padding-bottom: calc(3.6rem + env(safe-area-inset-bottom));
    }
  }

  /* ---- PC: 右端の色紙しおり ---- */
  @media (min-width: 1024px) {
    .shiori {
      top: 50%;
      right: 0;
      transform: translateY(-50%);
    }
    .shiori::after {
      display: none;
    }
    .shiori__list {
      display: grid;
      gap: 0.5rem;
      justify-items: end;
    }
    .shiori__short {
      display: none;
    }
    .shiori__tab {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      /* 右端は画面外へはみ出させ、左の破れ目だけ見せる */
      margin-right: -8px;
      min-height: 44px;
      padding: 0.5rem 1.9rem 0.5rem 0.9rem;
      font-family: var(--font-hand);
      font-weight: 700;
      font-size: 1.25rem;
      line-height: 1.2;
      white-space: nowrap;
      transition: transform 0.2s ease, padding 0.2s ease;
    }
    /* 色紙を一枚ずつ変える */
    li:nth-child(1) .shiori__tab {
      --torn-bg: #ecd29e;
    }
    li:nth-child(2) .shiori__tab {
      --torn-bg: #ead0d4;
    }
    li:nth-child(3) .shiori__tab {
      --torn-bg: #d9e2bf;
    }
    li:nth-child(4) .shiori__tab {
      --torn-bg: #d7e3ea;
    }
    li:nth-child(5) .shiori__tab {
      --torn-bg: #f0e3c8;
    }
    .shiori__tab:hover,
    .shiori__tab[aria-current="location"] {
      padding-right: 2.5rem;
    }
    .shiori__tab[aria-current="location"] {
      color: var(--wine);
      --torn-shadow: drop-shadow(-2px 5px 5px rgba(46, 40, 38, 0.32));
    }
  }
  /* 余白の狭い PC 幅では、しおりの頭だけ覗かせて引き出す */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .shiori__tab {
      transform: translateX(calc(100% - 3rem));
    }
    .shiori__tab:hover,
    .shiori__tab:focus-visible,
    .shiori__tab[aria-current="location"] {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shiori__tab {
      transition: none;
    }
  }
</style>

<script>
  // 画面の中央付近にあるセクションのしおりを「現在地」にする
  const tabs = new Map<string, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-shiori]")) {
    tabs.set(a.dataset.shiori!, a);
  }
  const setCurrent = (id: string | null) => {
    for (const [key, a] of tabs) {
      if (key === id) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    }
  };
  if ("IntersectionObserver" in window) {
    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        // ページ順で最初に見えているものを採用
        setCurrent([...tabs.keys()].find((id) => visible.has(id)) ?? null);
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    for (const id of tabs.keys()) {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    }
  }
</script>
