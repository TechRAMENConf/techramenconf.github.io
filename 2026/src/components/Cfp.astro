---
// CfP（登壇者募集）。中身は src/data/cfp.json を書き換えて切り替える。
//   status: "soon"（準備中）| "open"（募集中）| "closed"（締切）
import cfpData from "../data/cfp.json";
import { jp } from "../lib/jp";

type Status = "soon" | "open" | "closed";
const cfp = cfpData as {
  status: Status;
  url: string;
  deadlines?: { label: string; date: string }[];
  deadlineNote?: string;
  /** 締切（closed）のときの一言。無ければ「締め切りました」だけ */
  closedMessage?: string;
  summary: string;
  /** 募集中に添える案内（note の記事など） */
  info?: { label: string; url: string };
  formats?: { name: string; length: string }[];
};

const STAMP: Record<Status, string> = { soon: "準備中", open: "募集中", closed: "締切" };
const status: Status = cfp.status in STAMP ? cfp.status : "soon";
---

<section id="cfp" class="section">
  <div class="wrap sheet reveal">
    <p class="eyebrow">話してみませんか</p>
    <h2 class="section-title">登壇者募集<span class="cfp__en hand">CfP</span></h2>

    <div class="card tilt-l cfp__form">
      <p class:list={["cfp__stamp", `cfp__stamp--${status}`]} data-stamp>
        {STAMP[status]}
      </p>

      {
        status === "closed" ? (
          <p
            class="cfp__text jp"
            set:html={jp(cfp.closedMessage ?? "プロポーザルの募集は締め切りました。たくさんのご応募ありがとうございました！")}
          />
        ) : (
          <>
            {status === "open" && cfp.deadlines && cfp.deadlines.length > 0 && (
              <dl class="cfp__deadlines">
                {cfp.deadlines.map((d) => (
                  <div class="cfp__deadline">
                    <dt class="hand">{d.label}</dt>
                    <dd>{d.date}</dd>
                  </div>
                ))}
              </dl>
            )}
            {status === "open" && cfp.deadlineNote && (
              <p class="cfp__dnote jp" set:html={jp(`※ ${cfp.deadlineNote}`)} />
            )}
            <p class="cfp__text jp" set:html={jp(cfp.summary)} />
            {status === "open" && cfp.formats && cfp.formats.length > 0 && (
              <ul class="cfp__formats">
                {cfp.formats.map((f) => (
                  <li>
                    <span>{f.name}</span>
                    <b>{f.length}</b>
                  </li>
                ))}
              </ul>
            )}
          </>
        )
      }

      {
        status === "open" && cfp.url && (
          <a class="btn" href={cfp.url} target="_blank" rel="noopener">
            fortee で応募する
          </a>
        )
      }
      {
        status === "open" && cfp.info && (
          <p class="cfp__hint jp">
            <a href={cfp.info.url} target="_blank" rel="noopener">{cfp.info.label}</a>
          </p>
        )
      }
      {
        status === "soon" && (
          <p class="cfp__hint jp" set:html={jp("募集開始はこのページと公式 note でお知らせします。")} />
        )
      }
    </div>
  </div>
</section>

<style>
  .cfp__en {
    margin-left: 0.4em;
    font-size: 0.6em;
    color: var(--wine);
  }
  .cfp__form {
    max-width: 40rem;
    margin-top: 2.6rem;
    /* 判子が上の角に重なるので、上に余白を空ける */
    padding-top: 2.2rem;
  }
  .cfp__deadlines {
    display: grid;
    gap: 0.1rem;
    margin: 0 0 0.4rem;
  }
  .cfp__deadline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6em;
    font-size: 1.3rem;
    color: var(--grape);
  }
  .cfp__deadline dt {
    color: var(--wine);
    font-size: 1.1em;
  }
  .cfp__deadline dd {
    margin: 0;
    font-weight: 700;
  }
  .cfp__dnote {
    margin: 0 0 0.9rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .cfp__text {
    margin: 0 0 1.2rem;
    max-width: 30rem;
  }
  /* 募集枠: 品書きのように点線でつなぐ */
  .cfp__formats {
    display: grid;
    gap: 0.35rem;
    max-width: 26rem;
    margin: 0 0 1.4rem;
    padding: 0;
    list-style: none;
  }
  .cfp__formats li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    border-bottom: 1.5px dashed rgba(46, 40, 38, 0.3);
  }
  .cfp__formats b {
    flex: none;
    color: var(--grape);
  }
  .cfp__hint {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink);
  }

  /* 判子: 手で押した朱肉風。状態で色を変える */
  .cfp__stamp {
    position: absolute;
    top: -1.9rem;
    right: -0.6rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4.8rem;
    height: 4.8rem;
    margin: 0;
    border: 3px double currentColor;
    border-radius: 50%;
    background: rgba(251, 244, 230, 0.55);
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
    transform: rotate(-12deg);
    opacity: 0.9;
    filter: url(#rough);
  }
  @media (min-width: 720px) {
    .cfp__stamp {
      top: -2.2rem;
      right: -1.4rem;
      width: 5.8rem;
      height: 5.8rem;
      font-size: 1.45rem;
    }
  }
  .cfp__stamp--soon {
    color: var(--ink-soft);
  }
  .cfp__stamp--open {
    color: var(--wine);
  }
  .cfp__stamp--closed {
    color: #6f6862;
  }
</style>
