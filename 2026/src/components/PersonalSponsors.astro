---
// ラーメン応援団（個人スポンサー）。2025 と同じく、ビルド時に Google Apps Script から一覧を取る。
// 取れない（URL 未設定・失効・JSON 以外）ときは保存分 data/personal_sponsors.json を使い、
// ビルドは止めない（2025 は一時 URL の失効でビルドごと止まった）。0 人なら欄ごと出さない。
import { PERSONAL_SPONSORS } from "../data/personalSponsors";
import saved from "../data/personal_sponsors.json";

interface Sponsor {
  userName: string;
  avatarUrl?: string;
  twitterScreenName?: string;
  twitterUrl?: string;
}

const valid = (list: unknown): Sponsor[] =>
  Array.isArray(list)
    ? (list as Sponsor[]).filter((s) => typeof s?.userName === "string" && s.userName.trim() !== "")
    : [];

let sponsors: Sponsor[] = [];
if (PERSONAL_SPONSORS.gasUrl) {
  try {
    const res = await fetch(PERSONAL_SPONSORS.gasUrl, { signal: AbortSignal.timeout(10000) });
    if (res.ok) sponsors = valid(await res.json());
  } catch (err) {
    console.warn("[PersonalSponsors] GAS から取得できませんでした。保存分を使います", err);
  }
}
if (sponsors.length === 0) sponsors = valid(saved);

// avatarUrl は fortee の相対パス。未設定は fortee の既定画像になっているので出さない
const avatar = (s: Sponsor) =>
  s.avatarUrl && !s.avatarUrl.includes("avatar-blank")
    ? new URL(s.avatarUrl.replace(/^\//, ""), "https://fortee.jp/").href
    : null;
---

{
  sponsors.length > 0 && (
    <section id="supporters" class="section">
      <div class="wrap sheet reveal">
        <p class="eyebrow">個人スポンサー</p>
        <h2 class="section-title">
          ラーメン応援団<small class="supporters__count">{sponsors.length} 人</small>
        </h2>

        <ul class="supporters">
          {sponsors.map((s) => {
            const src = avatar(s);
            const Tag = s.twitterUrl ? "a" : "span";
            return (
              <li>
                <Tag
                  class="seal"
                  title={s.userName}
                  {...(s.twitterUrl ? { href: s.twitterUrl, target: "_blank", rel: "noopener" } : {})}
                >
                  {src ? (
                    <img src={src} alt="" width="56" height="56" loading="lazy" decoding="async" />
                  ) : (
                    <span class="seal__none" aria-hidden="true">
                      {s.userName.trim().slice(0, 1)}
                    </span>
                  )}
                  <span class="seal__name">{s.userName}</span>
                </Tag>
              </li>
            );
          })}
        </ul>

        {
          PERSONAL_SPONSORS.joinUrl && (
            <a class="btn supporters__join" href={PERSONAL_SPONSORS.joinUrl} target="_blank" rel="noopener">
              応援団員になる
            </a>
          )
        }
      </div>
    </section>
  )
}

<style>
  .supporters__count {
    margin-left: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.45em;
    color: var(--ink-soft);
  }
  .supporters {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.6rem, 1fr));
    gap: 1rem 0.6rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* 丼の縁に貼る丸いシール。名前は下に手書きで */
  .seal {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    color: var(--ink);
    text-decoration: none;
  }
  .seal img,
  .seal__none {
    width: 56px;
    height: 56px;
    border: 3px solid var(--paper-card);
    border-radius: 50%;
    object-fit: cover;
    background: var(--paper-deep);
    box-shadow: 0 4px 8px -4px rgba(46, 40, 38, 0.55);
    transition: translate 0.15s ease, rotate 0.15s ease;
  }
  li:nth-child(4n + 1) .seal img,
  li:nth-child(4n + 1) .seal__none {
    rotate: -6deg;
  }
  li:nth-child(4n + 3) .seal img,
  li:nth-child(4n + 3) .seal__none {
    rotate: 5deg;
  }
  .seal__none {
    display: grid;
    place-items: center;
    font-family: "Yomogi", var(--font-hand);
    font-size: 1.5rem;
    color: var(--wine);
  }
  .seal__name {
    max-width: 100%;
    font-family: "Yomogi", var(--font-hand);
    font-size: 0.8rem;
    line-height: 1.3;
    text-align: center;
    overflow-wrap: anywhere;
  }
  a.seal:hover img,
  a.seal:hover .seal__none {
    translate: 0 -3px;
    rotate: 0deg;
  }
  a.seal:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
    border-radius: 8px;
  }
  .supporters__join {
    margin-top: 2rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .seal img,
    .seal__none {
      transition: none;
    }
  }
</style>
