---
// 公式 note の新着。ビルド時に RSS を取得する（静的サイトなので、更新されるのはデプロイ時）。
// 取得に失敗してもビルドは止めず、マガジンへのリンクだけを表示する。
import Parser from "rss-parser";

const MAGAZINE = "https://note.com/techramenconf/m/m0938ea0596c0";
const LIMIT = 5;
// 日付は日本時間で表示（UTC のまま切り出すと深夜〜朝の投稿が前日になる）
const jstDate = new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

let items: { title: string; link: string; date: string }[] = [];
try {
  const feed = await new Parser({ timeout: 8000 }).parseURL(`${MAGAZINE}/rss`);
  items = feed.items
    .filter((it) => it.title && it.link)
    .slice(0, LIMIT)
    .map((it) => ({
      title: it.title!,
      link: it.link!,
      date: it.isoDate ? jstDate.format(new Date(it.isoDate)).replaceAll("/", ".") : "",
    }));
} catch (err) {
  console.warn("[NoteFeed] note の RSS を取得できませんでした。リンクのみ表示します", err);
}
---

<section id="news" class="section">
  <div class="wrap sheet reveal">
    <p class="eyebrow">おしらせ</p>
    <h2 class="section-title">公式 note から</h2>

    {
      items.length > 0 && (
        <ul class="news">
          {items.map((it) => (
            <li class="news__slip">
              <a class="torn" href={it.link} target="_blank" rel="noopener">
                {it.date && <span class="news__date hand">{it.date}</span>}
                <span class="news__title">{it.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <a
      class:list={["btn btn--ghost news__more", items.length === 0 && "news__more--solo"]}
      href={MAGAZINE}
      target="_blank"
      rel="noopener"
    >
      公式 note でもっと読む
    </a>
  </div>
</section>

<style>
  .news {
    display: grid;
    gap: 1.4rem 1.2rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    margin: 2.2rem 0 2rem;
    padding: 0;
    list-style: none;
  }

  /* 画鋲で留めた紙の短冊 */
  .news__slip {
    position: relative;
    transition: transform 0.15s ease;
  }
  .news__slip:nth-child(3n + 1) {
    transform: rotate(-1.2deg);
  }
  .news__slip:nth-child(3n + 2) {
    transform: rotate(0.8deg);
  }
  .news__slip:nth-child(3n) {
    transform: rotate(-0.4deg);
  }
  .news__slip:hover {
    transform: rotate(0deg) translateY(-2px);
  }
  /* 画鋲 */
  .news__slip::before {
    content: "";
    position: absolute;
    top: -7px;
    left: 50%;
    width: 13px;
    height: 13px;
    z-index: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #e9c27a, var(--gold) 60%, #9a6f25);
    box-shadow: 0 2px 2px rgba(46, 40, 38, 0.35);
  }
  .news__slip a {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: 1.1rem 1rem 1rem;
    color: inherit;
    text-decoration: none;
  }
  .news__date {
    color: var(--wine);
    font-size: 1.1rem;
  }
  .news__title {
    font-weight: 700;
    line-height: 1.55;
    color: var(--grape);
    /* 長いタイトルは 3 行で省略 */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news__slip a:hover .news__title {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 3px;
  }
  .news__slip a:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
    border-radius: inherit;
  }
  .news__more {
    margin-top: 0.4rem;
  }
  .news__more--solo {
    margin-top: 2rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .news__slip {
      transition: none;
    }
  }
</style>
