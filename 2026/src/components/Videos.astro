---
// 閉幕後の動画（エンディング・幕間など）。あいさつのすぐ下に並べる。
// 中身は data/videos.json の videos に { "title": "Ending", "youtube": "<YouTube の id>" } を書く。空なら欄ごと出さない。
// 大きく出すので、サムネイルは高解像度（maxresdefault）も使う。YouTube 側に無い動画を足すときは表示を確かめる
// 押すまで YouTube を読み込まない（サムネイルだけ出し、押したら youtube-nocookie の iframe に差し替える）。
import videos from "../data/videos.json";

const list = videos.videos as { title: string; youtube: string }[];
---

{
  list.length > 0 && (
    <section id="videos" class="section videos">
      <div class="wrap sheet reveal">
        <h2 class="section-title">動画</h2>
        <ul class="videos__list">
          {list.map((v) => (
            <li class="videos__item">
              <h3 class="videos__title hand">{v.title}</h3>
              <div class="videos__frame">
                <button type="button" class="videos__play" data-youtube={v.youtube} data-title={v.title}>
                  <img
                    src={`https://i.ytimg.com/vi/${v.youtube}/hqdefault.jpg`}
                    srcset={`https://i.ytimg.com/vi/${v.youtube}/hqdefault.jpg 480w, https://i.ytimg.com/vi/${v.youtube}/maxresdefault.jpg 1280w`}
                    sizes="(min-width: 760px) 920px, 100vw"
                    alt=""
                    width="480"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="videos__icon" aria-hidden="true" />
                  <span class="visually-hidden">{v.title} を再生</span>
                </button>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script>
  // 押したら、その場で YouTube の再生画面に差し替える
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".videos__play")) {
    btn.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(btn.dataset.youtube!)}?autoplay=1`;
      iframe.title = btn.dataset.title ?? "YouTube";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
      iframe.focus();
    });
  }
</script>

<style>
  .videos__list {
    display: grid;
    gap: 1.6rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* 大きく見せたいので、幅が広くても 1 本ずつ縦に並べる */
  .videos__title {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
    color: var(--wine);
  }
  .videos__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    background: #2e2826;
    box-shadow: 0 10px 18px -12px rgba(46, 40, 38, 0.6);
  }
  .videos__frame :global(iframe),
  .videos__play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .videos__play {
    display: grid;
    place-items: center;
    padding: 0;
    background: none;
    cursor: pointer;
  }
  .videos__play img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 再生ボタン: 紙を切り抜いたような三角 */
  .videos__icon {
    position: relative;
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 50%;
    background: var(--wine);
    box-shadow: 0 6px 14px -6px rgba(0, 0, 0, 0.6);
    transition: transform 0.15s ease;
  }
  .videos__icon::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    left: 0.35rem;
    width: 0;
    height: 0;
    border-block: 0.8rem solid transparent;
    border-left: 1.3rem solid #f7f2e3;
  }
  .videos__play:hover .videos__icon,
  .videos__play:focus-visible .videos__icon {
    transform: scale(1.08);
  }
  .videos__play:focus-visible {
    outline: 3px solid var(--wine);
    outline-offset: 3px;
  }
</style>
