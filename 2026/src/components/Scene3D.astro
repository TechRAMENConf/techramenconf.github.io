---
// ページ全体を貫く固定背景の3D。スクロールでカメラが富良野を巡る。
// 情報はこの上の半透明パネルに乗る（装飾レイヤー・aria-hidden）。
---

<div class="scene3d" aria-hidden="true">
  <!-- 静的フォールバック（3D未ロード/失敗/省モーション時もこれで成立） -->
  <div class="scene3d__fallback">
    <svg viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" role="presentation">
      <path d="M0 250 Q 200 210 400 245 T 800 235 V500 H0 Z" fill="#f3ece0" />
      <path d="M0 320 Q 220 280 430 315 T 800 300 V500 H0 Z" fill="#7a934a" />
      <path d="M0 380 Q 200 350 420 378 T 800 360 V500 H0 Z" fill="#ddb867" />
      <path d="M0 430 Q 240 405 460 428 T 800 415 V500 H0 Z" fill="#6a2f56" />
      <!-- ラーメン丼のシルエット（3Dの主役に合わせる） -->
      <g transform="translate(470 330)">
        <path d="M-62 0 Q -58 44 0 48 Q 58 44 62 0 Z" fill="#f6efe2" />
        <ellipse cx="0" cy="0" rx="62" ry="11" fill="#b5733a" stroke="#7b2c3a" stroke-width="4" />
        <path d="M-58 -16 L 60 -9 M-56 -22 L 62 -15" stroke="#c7a36a" stroke-width="3.5" stroke-linecap="round" />
      </g>
    </svg>
  </div>
  <canvas class="scene3d__canvas"></canvas>
</div>

<style>
  .scene3d {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    /* 寒い富良野の澄んだ空 → 地平のクラフト紙（3Dの透けにも対応） */
    background: linear-gradient(180deg, #cfe0e8 0%, #dde0d2 48%, #ece2cf 100%);
  }
  .scene3d__fallback,
  .scene3d__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .scene3d__fallback svg {
    width: 100%;
    height: 100%;
  }
  .scene3d__canvas {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .scene3d__canvas.is-ready {
    opacity: 1;
  }
  /* 3Dが出たらフェードイン完了後にフォールバックを隠す（透過キャンバス越しに二重に見えないよう） */
  .scene3d.is-3d .scene3d__fallback {
    visibility: hidden;
    transition: visibility 0s 0.8s;
  }
  /* 起き上がる導入があるときは、フェードせず即座に切り替える（導入そのものが「開く」演出） */
  .scene3d.has-intro .scene3d__canvas.is-ready {
    transition: none;
  }
  .scene3d.has-intro.is-3d .scene3d__fallback {
    transition: none;
  }
  :global(html.can-poke) {
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .scene3d__canvas,
    .scene3d.is-3d .scene3d__fallback {
      transition: none;
    }
  }
</style>

<script>
  import type { BeatName, VineyardController } from "../scenes/vineyard";

  const root = document.querySelector<HTMLElement>(".scene3d");
  const canvas = document.querySelector<HTMLCanvasElement>(".scene3d__canvas");

  function hasWebGL(): boolean {
    try {
      const c = document.createElement("canvas");
      const gl = (c.getContext("webgl") ||
        c.getContext("experimental-webgl")) as WebGLRenderingContext | null;
      if (!window.WebGLRenderingContext || !gl) return false;
      // 判定用コンテキストは即解放（ブラウザのコンテキスト上限を消費しない）
      gl.getExtension("WEBGL_lose_context")?.loseContext();
      return true;
    } catch {
      return false;
    }
  }

  if (canvas && hasWebGL()) {
    let controller: VineyardController | null = null;

    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      controller?.setProgress(max > 0 ? window.scrollY / max : 0);
    };

    // 各セクション（data-beat）の先頭が画面の 40% に来たときの進捗をビートの t にする。
    // セクションの増減・高さの変化に自動で追従する。
    const updateBeats = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (!controller || max <= 0) return;
      const beats: Partial<Record<BeatName, number>> = {};
      for (const el of document.querySelectorAll<HTMLElement>("[data-beat]")) {
        const top = el.getBoundingClientRect().top + window.scrollY;
        beats[el.dataset.beat as BeatName] = Math.min(
          1,
          Math.max(0, (top - window.innerHeight * 0.4) / max),
        );
      }
      controller.setBeats(beats);
    };
    const onLayoutChange = () => {
      updateBeats();
      updateProgress();
    };
    const layoutObserver = new ResizeObserver(onLayoutChange);

    // 隠し要素: 空いている所で丼や気球を突く。文字・ボタンなどの上では反応しない
    const isUi = (el: EventTarget | null) =>
      el instanceof Element &&
      !!el.closest(
        "a, button, input, .sheet, .nametag, .concept__note, .shiori, .hero__logo, .hero__facts, .hero__cta, .hero__tag, .foot",
      );
    const onPokeDown = (e: PointerEvent) => {
      if (!controller || isUi(e.target)) return;
      controller.poke(e.clientX, e.clientY);
    };
    // マウスのときだけ、突ける物の上でカーソルを指にする（rAF で間引く）
    let pokeX = 0;
    let pokeY = 0;
    let pokePending = false;
    const onPokeHover = (e: PointerEvent) => {
      if (e.pointerType !== "mouse" || !controller) return;
      pokeX = e.clientX;
      pokeY = e.clientY;
      if (pokePending) return;
      pokePending = true;
      requestAnimationFrame(() => {
        pokePending = false;
        const can =
          !!controller &&
          !isUi(document.elementFromPoint(pokeX, pokeY)) &&
          controller.canPoke(pokeX, pokeY);
        document.documentElement.classList.toggle("can-poke", can);
      });
    };

    // 非ブロッキングで three.js を遅延ロード
    (async () => {
      try {
        const { createVineyard } = await import("../scenes/vineyard");
        // 組み立て（テクスチャ生成など）は、ブラウザが空いているときに回す
        await new Promise<void>((r) =>
          "requestIdleCallback" in window
            ? requestIdleCallback(() => r(), { timeout: 1500 })
            : setTimeout(r, 200),
        );
        controller = createVineyard(canvas);
        await controller.ready; // シェーダの準備ができてから表示（初回描画でのカクつきを避ける）
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root?.classList.add("has-intro");
        }
        canvas.classList.add("is-ready");
        root?.classList.add("is-3d");
        controller.start();
        onLayoutChange();
        window.addEventListener("scroll", updateProgress, { passive: true });
        window.addEventListener("resize", onLayoutChange, { passive: true });
        layoutObserver.observe(document.body);
        document.addEventListener("pointerdown", onPokeDown);
        document.addEventListener("pointermove", onPokeHover, { passive: true });
      } catch (err) {
        console.warn("[scene3d] 3D init failed, keeping static fallback", err);
      }
    })();

    // タブ非表示で一時停止
    const onVisibility = () => {
      if (document.hidden) controller?.stop();
      else controller?.start();
    };
    document.addEventListener("visibilitychange", onVisibility);

    // 将来 View Transitions 等でページが入れ替わる際にリスナー/リソースを解放
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("scroll", updateProgress);
        window.removeEventListener("resize", onLayoutChange);
        layoutObserver.disconnect();
        document.removeEventListener("pointerdown", onPokeDown);
        document.removeEventListener("pointermove", onPokeHover);
        document.removeEventListener("visibilitychange", onVisibility);
        controller?.dispose();
      },
      { once: true },
    );
  }
</script>
